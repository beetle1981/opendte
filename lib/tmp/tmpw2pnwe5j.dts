					<3 RK_PA6 1 &pcfg_pull_none>,

					<3 RK_PA5 1 &pcfg_pull_none_13ma>,

					<3 RK_PA4 1 &pcfg_pull_none_13ma>,

					<3 RK_PA3 1 &pcfg_pull_none>,

					<3 RK_PA2 1 &pcfg_pull_none>,

					<3 RK_PA1 1 &pcfg_pull_none_13ma>,

					<3 RK_PA0 1 &pcfg_pull_none_13ma>;
